; ============================================================
; Part 1: Main Agent Configuration (Dandelion CLI)
; ============================================================
[Main]
; Specify the model alias (from MODEL_LIST below) used by the main agent
MAIN_AGENT=opus
SUB_LIST=[
    "opus",
    "gemini"
    ]
SUB_DEPTH=1
SUB_CONCURRENCY=4
; Optional comma-separated extra directories for hot-plugged BaseTool modules:
; TOOL_DIRS=
; Search Tool
TAVILY_API_KEY=tvly-

; ============================================================
; Part 2: Provider Profiles & Model Registries
;
; @ SDK_TYPE (5 native C++17 protocols):
;   - "Message"          : Anthropic Messages API (/v1/messages)
;   - "Chat Completions" : OpenAI Chat Completions (/v1/chat/completions)
;   - "Responses"        : OpenAI Responses API (/v1/responses, stateless store=false)
;   - "Generate Content" : Gemini generateContent/streamGenerateContent
;                          (recommended for Gemini; supports native PDF + thoughtSignature
;                          on both AI Studio and Sub2API)
;   - "Interactions"     : Gemini v1beta/interactions
; @ BASE_URL:
;   URL to LLM provider.
; ============================================================

[Sub2API_Antigravity]
SDK_TYPE="Message"
BASE_URL=
API_KEY=sk-
MODEL_LIST = [
    {
        "provider": {
            "model_id": "gemini-3.8-flash-tiered",
            "compat": "gemini"
        },
        "basic": {
            "name": "gemini",
            "description": "Fast multimodal model supporting image/PDF inspection, routine file operations, and quick lookups.",
            "max_token": 128000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "high"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp", ".pdf"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    },
    {
        "provider": {
            "model_id": "claude-opus-5-5-high",
            "compat": "anthropic"
        },
        "basic": {
            "name": "opus",
            "description": "Strong reasoning model for complex architecture design, multi-file refactoring, debugging, and code review.",
            "max_token": 128000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "max"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp", ".pdf"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    }
    ]

[Sub2API_OpenAI]
SDK_TYPE="Message"
BASE_URL=
API_KEY=sk-
MODEL_LIST = [
    {
        "provider": {
            "model_id": "gpt-6.1-sol",
            "compat": "openai"
        },
        "basic": {
            "name": "gpt",
            "description": "High-reasoning general coding model suitable for algorithm design, verification, and code review.",
            "max_token": 128000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "max"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    }
    ]

[DeepSeek]
SDK_TYPE="Message"
BASE_URL=
API_KEY=sk-
MODEL_LIST = [
    {
        "provider": {
            "model_id": "deepseek-v4-flash",
            "compat": "deepseek"
        },
        "basic": {
            "name": "deepseek-v4",
            "description": "Fast cost-effective model for routine file inspection, text processing, and lightweight coding tasks.",
            "max_token": 160000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "max"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    }
    ]

; ============================================================
; Part 3: Optional Dandelion Remote Sync
; ============================================================
; Configure this section to enable manual 'sync' and 'remote -v' in CLI.
; ACCESS_KEY must match [Server] ACCESS_KEY on your Dandelion Remote server
; (the client hashes ACCESS_KEY with MD5 before sending over HTTP/HTTPS).
; [Remote]
; NAME=origin
; URL=https://sub2api.swordofmorning.com/dandelion-sync
; ACCESS_KEY=dr-your-shared-secret-key
; DEVICE_ID=work-laptop

[Memory]
PASSIVE_TOP_K=5
MIN_SIMILARITY=0.35

[Embedding]
; Set PROVIDER=gemini for Google AI Studio vector memory (recommended model:
; gemini-embedding-001; legacy embedding-001 / text-embedding-004 are deprecated):
; PROVIDER=gemini
; MODEL=gemini-embedding-001
; DIMENSIONS=768
; BASE_URL=https://generativelanguage.googleapis.com
; API_KEY=
; API_KEY_ENV=GEMINI_API_KEY
; TIMEOUT_MS=3000
; BATCH_SIZE=32
PROVIDER=disabled
MODEL=gemini-embedding-001
DIMENSIONS=768
BASE_URL=
API_KEY=
API_KEY_ENV=
TIMEOUT_MS=3000
BATCH_SIZE=32

; ============================================================
; Part 4: Optional Hot-Plugged Tool Configuration ([Tool:<name>])
; ============================================================
; Drop a BaseTool module into src/tool/, src/cli/tool/, or tool/ and configure
; its credentials here (read via context.tool_config("<name>") or
; config["TOOL_CONFIG"]["<name>"]).
; [Tool:imap]
; HOST=imap.example.com
; PORT=993
; USERNAME=user@example.com
; PASSWORD=app-password
; FOLDER=INBOX
