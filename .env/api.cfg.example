; ============================================================
; Part 1: Main Agent Configuration
; ============================================================
[Main]
; Specify the actual model_id to be used by the main agent
MAIN_AGENT=gemini-3.8-flash
SUB_LIST=[
    "gemini-3.8-flash"
    ]
; Search Tool
TAVILY_API_KEY=tvly-

; ============================================================
; Part 2: Provider Profiles & Model Registries
; 
; @ SDK_TYPE:
;   "Message" (Anthropic) or "Chat Completions" (OpenAI).
;   do not support "Responses" (OpenAI New), "Interactions" (Gemini New) or "Generate Content"(Gemini)
; @ BASE_URL:
;   URL to LLM provider.
; ============================================================

[DeepSeek]
SDK_TYPE="Message"
BASE_URL=https://api.deepseek.com/anthropic
API_KEY=sk-
MODEL_LIST = [
    {
        "provider": {
            "model_id": "deepseek-v4-flash",
            "compat": "deepseek"
        },
        "basic": {
            "name": "deepseek-v4",
            "conditions": ["tool_heavy", "long_context", "simple"],
            "max_token": 160000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "max"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    }
    ]

[Sub2API_Antigravity]
SDK_TYPE="Message"
BASE_URL=
API_KEY=sk-
MODEL_LIST = [
    {
        "provider": {
            "model_id": "gemini-3.8-flash-tiered",
            "compat": "gemini"
        },
        "basic": {
            "name": "gemini-3.8-flash",
            "conditions": ["reasoning", "tool_heavy", "long_context", "simple"],
            "max_token": 128000,
            "max_context_tokens": 819200
        },
        "reasoning": {
            "thinking": "enabled",
            "effort": "high"
        },
        "media": {
            "file": [".png", ".jpg", ".jpeg", ".webp", ".pdf"],
            "max_image_bytes": "15MB",
            "max_pdf_bytes": "15MB",
            "max_pdf_pages": 100,
            "max_media_per_request": 8
        }
    }
    ]
