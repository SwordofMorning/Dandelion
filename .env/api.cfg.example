; ============================================================
; Part 1: Main Agent Configuration
; ============================================================
[Main]
; Specify the actual model_id to be used by the main agent
MAIN_AGENT=deepseek-v4-pro
SUB_LIST=[
    "deepseek-v4-pro",
    "deepseek-v4-flash"
    ]
; Search Tool
TAVILY_API_KEY=

; ============================================================
; Part 2: Provider Profiles & Model Registries
; ============================================================
;
; Media (multimodal) support is declared per model, so a text-only model never
; receives media tools. Optional keys inside a MODEL_LIST entry:
;
;   "file": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".pdf"],
;       Extension whitelist. Omit it (or use []) for text-only models: the
;       read_image / read_pdf tools are then NOT registered for that model.
;
;   "max_image_bytes": "15MB",     Single image size cap (int bytes or "15MB").
;   "max_pdf_bytes": "15MB",       Single PDF size cap.
;   "max_pdf_pages": 100,          Page cap for one PDF request (no page slicing).
;   "max_media_per_request": 8,    How many media blocks one request may carry.
;   "pdf_tokens_per_page": 258,    Cost estimate per PDF page (budget ledger).
;   "image_cost_factor": 1.2,      Safety factor on the image cost estimate.
;   "pdf_cost_factor": 1.2,        Safety factor on the PDF cost estimate.
;   "media_cost_fallback": 2000,   Cost assumed when a media size is unknown.
;   "calib_ratio_cap": 1.6,        Upper bound of the context calibration ratio.
;
; All keys are optional; the defaults above apply when they are absent.

[DeepSeek]
SDK_TYPE="Anthropic"
BASE_URL=https://api.deepseek.com/anthropic
API_KEY=
MODEL_LIST = [
    {
        "model_id": "deepseek-v4-flash",
        "conditions": ["tool_heavy", "long_context", "simple"],
        "max_token": 160000,
        "max_context_tokens": 419200,
        "file": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".pdf"],
        "max_image_bytes": "15MB",
        "max_pdf_bytes": "15MB",
        "max_pdf_pages": 100,
        "max_media_per_request": 8,
        "pdf_tokens_per_page": 258,
        "image_cost_factor": 1.2,
        "pdf_cost_factor": 1.2,
        "media_cost_fallback": 2000,
        "calib_ratio_cap": 1.6,
        "TPM": 1000000,
        "RPM": 1000,
        "RPD": 50000,
        "thinking": "enabled",
        "effort": "max"
    }
    ]
