; ============================================================
; Part 1: Main Agent Configuration
; ============================================================
[Main]
; Specify the actual model_id to be used by the main agent
MAIN_AGENT=deepseek-v4-pro

; ============================================================
; Part 2: Provider Profiles & Model Registries
; ============================================================
[DeepSeek]
SDK_TYPE="Anthropic"
BASE_URL=https://api.deepseek.com/anthropic
API_KEY=sk-your-deepseek-key
MODEL_LIST = [
    {
        "model_id": "deepseek-v4-pro",
        "conditions": ["reasoning", "tool_heavy", "long_context"],
        "max_token": 819200,
        "TPM": 0,
        "RPM": 10,
        "RPD": 500
    },
    {
        "model_id": "deepseek-v4-flash",
        "conditions": ["tool_heavy", "simple"],
        "max_token": 8192,
        "TPM": 1000000,
        "RPM": 10,
        "RPD": 500
    }
    ]

[OpenRouter]
SDK_TYPE="Anthropic"
BASE_URL=https://openrouter.ai/api
API_KEY=sk-or-v1-your-openrouter-key
MODEL_LIST = [
    {
        "model_id": "nvidia/nemotron-3-ultra-550b-a55b:free", 
        "conditions": ["long_context", "tool_heavy", "complex"],
        "max_token": 8192,
        "TPM": 1000000,
        "RPM": 10,
        "RPD": 500
    }
    ]

[AIStudio]
SDK_TYPE="AI Studio"
BASE_URL=https://generativelanguage.googleapis.com
API_KEY=AIzaSy-your-gemini-key
MODEL_LIST = [
    {
        "model_id": "gemma-4-31b-it",
        "conditions": ["reasoning", "tool_heavy", "long_context", "complex"],
        "max_token": 16000,
        "TPM": 16000,
        "RPM": 30,
        "RPD": 14400
    },
    {
        "model_id": "gemini-3.1-flash-lite",
        "conditions": ["simple"],
        "max_token": 81920,
        "TPM": 250000,
        "RPM": 15,
        "RPD": 500
    }
    ]

[Main]
MAIN_AGENT=meta/llama-3.1-70b-instruct

[Nvidia]
SDK_TYPE="OpenAI"
