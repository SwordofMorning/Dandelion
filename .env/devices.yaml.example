# ============================================================
# Dandelion Remote Device Config (Example)
# ============================================================
# Usage:
#   1. Copy this file to .env/devices.yaml (same dir as api.cfg).
#   2. Fill in host / user / credentials for your devices.
#   3. Credentials (password / key_path) live ONLY under the .env dir:
#      - .env is sandbox-shielded: agent tools cannot read this file;
#      - restrict directory permissions (Windows ACL / Linux chmod 600).
#
# Auth priority: key_path (key) first, then password.
# Password is stored in plaintext; intended for embedded boards that have
# no public key and share a common password per board model.
#
# Optional per-device "security" map:
#   allow: exempt verbs from the default blocked list
#          (defaults: src/tool/shell/ssh_tool.py, _BLOCKED_VERBS)
#   block: add extra blocked verbs
#
# Default safety rules (semantic analysis, not blanket path blocking):
#   P1: command containing the ".env" substring -> blocked
#   R1: access to /etc/shadow, /etc/gshadow -> blocked
#   R2: rm/mv/cp targeting top-level critical dirs (/, /etc, /boot, ...)
#       or traversing into them -> blocked; sub-paths such as /etc/init.d
#       and normal relative paths are allowed
#   R3: mkfs*/fdisk/parted/flash_erase/nandwrite/ubiformat/passwd/
#       shutdown/poweroff/halt/reboot/init 0|1|6 -> blocked by default
#       (exempt via security.allow)
#   R4: dd writing to /dev/mtd*, /dev/mmcblk*, /dev/sd* etc. -> blocked;
#       dd reading (backup images) is allowed

# ------------------------------------------------------------
# Example 1: Ubuntu host (key auth)
# ------------------------------------------------------------
ubuntu:
  type: ssh
  host: 192.168.1.1
  port: 22
  user: ubuntu
  key_path: C:/Users/<your_name>/.ssh/id_ed25519
  timeout: 120

# ------------------------------------------------------------
# Example 2: Embedded board (no public key, shared plaintext password)
# ------------------------------------------------------------
board_ssh:
  type: ssh
  host: 192.168.1.2
  user: root
  password: <shared-password-for-this-board-model>
  timeout: 60
  security:
    allow: [reboot]      # example: allow reboot (blocked by default)
    # block: [touch]     # example: add an extra blocked verb

# ------------------------------------------------------------
# Example 3: Serial device (reserved; serial tool deferred)
# ------------------------------------------------------------
# board_serial:
#   type: serial
#   port: COM3
#   baudrate: 115200
#   bytesize: 8
#   parity: none
#   stopbits: 1
#   newline: "\n"
#   encoding: utf-8
#   buf_size: 65536
#   read_timeout: 3
