[build]
entry = main.py
mode = standalone
output_dir = build
cache_dir = .nuitka-cache
icon = mk/config/dandelion.ico
company = SwordofMorning
description = Dandelion CLI Agent
python = auto

[nuitka]
jobs = 4
windows_jobs = 2
stdlib_fallback = true
# Nuitka compilation report (included modules, used for the package audit).
report = true
extra_args =

# Nuitka config: Do not compile these heavy SDKs and libraries to C.
nofollow_imports = pydantic,anthropic,openai,openpyxl,tabulate,httpx,anyio,certifi,urllib3,idna,charset_normalizer,requests

# Custom config: Manually copy these packages to the dist folder (bypassing Nuitka).
copy_packages = pydantic,anthropic,openai,openpyxl,tabulate,httpx,anyio,certifi,urllib3,idna,charset_normalizer,requests

# Custom config: Force compile standard libraries required by the bypassed packages.
include_std_modules = http.cookies,http.cookiejar,email.parser,email.message,html.parser,urllib.parse,urllib.request,urllib.error,csv,ctypes,sqlite3

[strip]
# Linux only: strip --strip-unneeded on ELF executables / shared objects in
# bin/ (runs inside the target container, BEFORE the RPATH fix). Originals are
# kept in <output_dir>/unstripped/ and every object is recorded in
# <output_dir>/strip-ledger.tsv. Override at build time: DANDELION_STRIP=0|1.
enabled = true
# On a per-file strip failure: "keep" = keep the original object (recorded as
# FAILED-KEPT in the ledger, build continues); "fail" = abort the build.
on_error = keep

[audit]
# The build fails if any of these top-level packages shows up in the final
# artifact tree (bin/, dist-info, *.libs) or in the Nuitka report.
forbidden_packages = pandas,numpy

[sign]
enabled = false
tool = signtool
cert_file =
