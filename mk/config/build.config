# Dandelion build configuration.
# Loaded by mk/make.py (configparser INI).

[build]
entry = main.py
mode = standalone
output_dir = build
cache_dir = .nuitka-cache
icon = mk/config/dandelion.ico
company = SwordofMorning
description = Dandelion CLI Agent
python = auto

[nuitka]
jobs = 4
extra_args =

[sign]
enabled = false
tool = signtool
cert_file =
