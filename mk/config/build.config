[build]
entry = main.py
mode = standalone
output_dir = build
cache_dir = .nuitka-cache
icon = mk/config/dandelion.ico
company = SwordofMorning
description = Dandelion CLI Agent
python = auto

[core]
package_dir = packages/dandelion-core
wheel_dir = dist

[nuitka]
jobs = 4
windows_jobs = 2
stdlib_fallback = true
stdlib_fallback_mode = full
extra_args =

# Nuitka config: Do not compile these pure-Python / helper libraries to C.
nofollow_imports = openpyxl,tabulate,certifi,urllib3,idna,charset_normalizer,requests,tzdata

# Custom config: Manually copy these packages to the dist folder (bypassing Nuitka).
copy_packages = openpyxl,tabulate,certifi,urllib3,idna,charset_normalizer,requests,tzdata

# Custom config: Force compile standard libraries required by bypassed packages and hot-plugged tools.
include_std_modules = http.cookies,http.cookiejar,email.parser,email.message,html.parser,urllib.parse,urllib.request,urllib.error,csv,ctypes,sqlite3,xml.etree.ElementTree,ssl,hmac,uuid,decimal,lzma,bz2

[sign]
enabled = false
tool = signtool
cert_file =
